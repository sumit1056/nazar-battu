{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "./out/renderer",
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": true
  },
  "include": ["src/renderer/**/*"]
}
